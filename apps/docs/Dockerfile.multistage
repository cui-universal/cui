# =============================================================================
# Multi-stage Dockerfile: Builds CUI packages & Docs entirely inside container
# =============================================================================
FROM node:24-slim AS builder

WORKDIR /app

# Enable corepack and install pnpm
RUN npm install -g pnpm@12.3.4

# Copy workspace configuration and manifests for layer caching
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY packages/theme/package.json ./packages/theme/
COPY packages/react/package.json ./packages/react/
COPY packages/vue/package.json ./packages/vue/
COPY apps/docs/package.json ./apps/docs/
COPY apps/nuxt/package.json ./apps/nuxt/

# Install workspace dependencies needed for docs
RUN pnpm --filter docs... install --frozen-lockfile

# Copy sources
COPY packages/theme ./packages/theme
COPY packages/react ./packages/react
COPY apps/docs ./apps/docs

# Build internal packages and documentation
RUN pnpm --filter @cui-universal/theme build && \
    pnpm --filter @cui-universal/react build && \
    pnpm --filter docs build

# =============================================================================
# Production Nginx Runner Stage
# =============================================================================
FROM nginx:alpine AS runner

RUN rm -rf /usr/share/nginx/html/*

COPY apps/docs/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/apps/docs/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://127.0.0.1/healthz || exit 1

STOPSIGNAL SIGQUIT

CMD ["nginx", "-g", "daemon off;"]
