{
  "name": "@cui/theme",
  "version": "0.1.0",
  "description": "Cross-framework design system tokens, Tailwind plugin, and variants for CUI",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "files": [
    "dist",
    "src/styles.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cui-universal/cui.git"
  },
  "homepage": "https://github.com/cui-universal/cui#readme",
  "keywords": [
    "cui",
    "tailwind",
    "theme",
    "design-system",
    "tokens",
    "react",
    "vue",
    "nuxt",
    "nextjs"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.0.2",
    "tailwind-variants": "^0.3.1"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2"
  }
}
