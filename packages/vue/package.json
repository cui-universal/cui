{
  "name": "@cui-universal/vue",
  "version": "0.1.0-beta.1",
  "description": "Cross-framework CUI components for Vue 3 and Nuxt",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./nuxt": {
      "types": "./dist/nuxt.d.ts",
      "import": "./dist/nuxt.js",
      "require": "./dist/nuxt.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cui-universal/cui.git"
  },
  "homepage": "https://github.com/cui-universal/cui#readme",
  "keywords": [
    "cui",
    "vue",
    "nuxt",
    "nuxt3",
    "ui",
    "components",
    "tailwind",
    "accessible",
    "nuxt-ui"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "dependencies": {
    "@cui-universal/theme": "workspace:*",
    "lucide-vue-next": "^0.473.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "^5.8.2",
    "vite": "^6.1.0",
    "vite-plugin-dts": "^4.5.0",
    "vue": "^3.5.13"
  }
}
